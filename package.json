{
    "name": "setup-npm-version-action",
    "version": "0.0.2",
    "type": "module",
    "author": "Kris Papercut <krispcut@gmail.com>",
    "description": "Sets up package version with tag and auto-incremented index",
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "postbuild": "ncc build -o dist src/index.ts && cp ./action.yml ./dist/action.yml",
        "watch": "tsc -w --project tsconfig.build.json",
        "test": "vitest run --coverage",
        "test-watch": "vitest"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/exec": "^1.1.1",
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@types/node": "^22.15.17",
        "@vercel/ncc": "^0.38.3",
        "@vitest/coverage-v8": "^4.0.8",
        "memfs": "^4.17.1",
        "typescript": "^5.9.3",
        "vitest": "^4.0.8"
    }
}
